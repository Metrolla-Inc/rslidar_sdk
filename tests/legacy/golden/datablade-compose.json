{
  "exec": {
    "argv": [
      "ros2",
      "launch",
      "rslidar_sdk",
      "start.py"
    ],
    "env": {
      "ROS_DISTRO": "jazzy",
      "ROS_LOCALHOST_ONLY": "1",
      "ROS_LOG_DIR": "/var/log/ros2",
      "SOURCED": "/opt/ros/jazzy:/ros2_ws/install",
      "USE_MACADDRESS_NS": "0"
    }
  },
  "exit": 0,
  "stderr": "",
  "stdout": ""
}
