exit: 1
--- stdout
{
  "refused": [
    "LIDAR_MODEL is set but empty; accepted: a RoboSense model such as rshelios, rs128 or rsm1 (the full list is in the message when the name is unknown)",
    "SENSOR_IP is set but empty; accepted: the sensor's own IPv4 address, for example 192.168.1.200",
    "DATA_PORT is set but empty; accepted: a UDP port 1024-65535 (default 6699), or unset it for the default",
    "TIME_MODE is set but empty; accepted: host, sensor, gps or ptp (default host), or unset it for the default"
  ]
}
