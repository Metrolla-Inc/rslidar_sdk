exit: 0
--- stdout
{
  "model": {
    "key": "rs128",
    "label": "RS-Ruby-128",
    "lidar_type": "RS128"
  },
  "sensor_ip": "192.168.10.200",
  "data_port": 6700,
  "device_port": 7789,
  "topic": "/north_gate/points",
  "frame_id": "north_gate_lidar",
  "time_mode": "ptp",
  "config_file": "/tmp/rs/config.yaml",
  "config": {
    "msg_source": "1",
    "send_packet_ros": "false",
    "send_point_cloud_ros": "true",
    "lidar_type": "RS128",
    "msop_port": "6700",
    "difop_port": "7789",
    "imu_port": "0",
    "max_distance": "200.0",
    "use_lidar_clock": "true",
    "ros_frame_id": "\"north_gate_lidar\"",
    "ros_send_point_cloud_topic": "\"/north_gate/points\""
  },
  "argv": [
    "/ros2_ws/install/rslidar_sdk/lib/rslidar_sdk/rslidar_sdk_node",
    "--ros-args",
    "-r",
    "__ns:=/north_gate",
    "-p",
    "config_path:=/tmp/rs/config.yaml"
  ],
  "sources": {
    "DATA_PORT": "env",
    "DEVICE_PORT": "env",
    "FRAME_ID": "env",
    "HOST_IP": "env",
    "LIDAR_MODEL": "env",
    "POINTCLOUD_TOPIC": "env",
    "PUBLISH_SCAN": "env",
    "RSLIDAR_RUN_DIR": "env",
    "SENSOR_ID": "env",
    "SENSOR_IP": "env",
    "TIME_MODE": "env"
  },
  "config_yaml": "# Rendered from the environment by the rslidar-driver image entrypoint; do not edit.\n# LIDAR_MODEL rs128 = RS-Ruby-128 (mechanical, lidar_type RS128); SENSOR_IP 192.168.10.200 (the driver listens on its ports for any sender; it does not filter by address)\n# TIME_MODE ptp: points are stamped with the sensor's own clock; the sensor must be set to this time source\n# HOST_IP 192.168.10.102/24: checked against SENSOR_IP; the driver listens on all addresses\n# topic /north_gate/points, frame north_gate_lidar\ncommon:\n  msg_source: 1  # 0: not use Lidar\n                                        # 1: packet message comes from online Lidar\n                                        # 2: packet message comes from ROS or ROS2\n                                        # 3: packet message comes from Pcap file\n  send_packet_ros: false  # true: Send packets through ROS or ROS2(Used to record packet)\n  send_point_cloud_ros: true  # true: Send point cloud through ROS or ROS2\nlidar:\n  - driver:\n      lidar_type: RS128  #  LiDAR type - RS16, RS32, RSBP, RSAIRY, RSAIRYLITE_ETH, RSFAIRY, RSHELIOS, RSHELIOS_16P, RS128, RS80, RS48, RSP128, RSP80, RSP48,\n                                   #               RSM1, RSM1_JUMBO, RSM2, RSM3, RSE1, RSMX, RSEMX.\n                                   \n      msop_port: 6700  #  Msop port of lidar\n      difop_port: 7789  #  Difop port of lidar (Note that: For RSEMX, use the port num of DIFOP2 if both DIFOP1 & DIFOP2 exist. Default 7766.)\n      imu_port: 0  #  IMU port of lidar(only for RSAIRY, RSAIRYLITE_ETH, RSFAIRY, RSE1), 0 means no imu.\n                                   #  If you want to use IMU, please first set ENABLE_IMU_DATA_PARSE to ON in CMakeLists.txt \n      user_layer_bytes: 0          #  Bytes of user layer. thers is no user layer if it is 0         \n      tail_layer_bytes: 0          #  Bytes of tail layer. thers is no tail layer if it is 0\n\n\n      min_distance: 0.2            #  Minimum distance of point cloud\n      max_distance: 200.0  #  Maximum distance of point cloud (Note that: 200 normally, 300 for RSEMX)\n      use_lidar_clock: true  #  true--Use the lidar clock as the message timestamp\n                                   #  false-- Use the system clock as the timestamp\n      dense_points: false          #  true: discard NAN points; false: reserve NAN points\n      \n      ts_first_point: true         #  true: time-stamp point cloud with the first point; false: with the last point;   \n                                   #  these parameters are used from mechanical lidar\n\n      start_angle: 0               #  Start angle of point cloud\n      end_angle: 360               #  End angle of point cloud\n\n                                   #  When msg_source is 3, the following parameters will be used\n      pcap_repeat: true            #  true: The pcap bag will repeat play   \n      pcap_rate: 1.0               #  Rate to read the pcap file\n      pcap_path: /home/robosense/lidar.pcap #The path of pcap file\n\n    ros:\n      ros_frame_id: \"north_gate_lidar\"  #Frame id of packet message and point cloud message\n      ros_recv_packet_topic: /rslidar_packets          #Topic used to receive lidar packets from ROS\n      ros_send_packet_topic: /rslidar_packets          #Topic used to send lidar packets through ROS\n      ros_send_imu_data_topic: /rslidar_imu_data         #Topic used to send imu data through ROS\n      ros_send_point_cloud_topic: \"/north_gate/points\"  #Topic used to send point cloud through ROS\n      ros_queue_length: 100                            #Topic QoS history depth\n"
}
--- stderr
